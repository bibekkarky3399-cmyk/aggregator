# Application
APP_NAME=API Aggregation Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (sqlite for local; use postgresql+asyncpg://user:pass@host/db for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./aggregator.db

# HTTP client defaults
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RETRIES=2
DEFAULT_RETRY_BACKOFF_SECONDS=0.5

# Aggregation
AGGREGATION_TIMEOUT_SECONDS=45

# Bootstrap admin (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
