# Copy to .env and fill in real values. .env is ignored by git and blocked by the secret scan.
# Generate long random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
DEBUG=false
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Database (docker-compose reads POSTGRES_PASSWORD; DATABASE_URL for running outside compose)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://aggregator:<password>@localhost:5432/aggregator

# United Solutions supplier login (from your supplier account manager; never commit)
US_ENDPOINT=<supplier endpoint URL>
US_USER_ID=<user id>
US_PASSWORD=<password>
US_AGENCY_ID=<agency id>
US_CLIENT_IP=<client ip>
